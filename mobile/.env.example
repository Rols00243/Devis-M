# ---------------------------------------------------------------------------
# MétréCards — variables d'environnement
# Copiez ce fichier en `.env` à la racine de `mobile/`, puis renseignez vos clés.
# `.env` est ignoré par git : aucune clé ne doit être commitée.
# ---------------------------------------------------------------------------

# --- Supabase (facultatif : sans ces deux clés, l'app reste 100 % locale) ----
# Tableau de bord Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé « anon / public » : publique par conception, sans pouvoir propre.
# Ce sont les règles RLS (voir supabase/schema.sql) qui protègent les données.
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# --- Identifiant du projet EAS (rempli automatiquement par `eas init`) -------
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# À NE JAMAIS METTRE ICI :
#
#   ANTHROPIC_API_KEY  → la clé du modèle de vision est un secret SERVEUR.
#                        Elle se configure sur la fonction Edge, jamais dans
#                        l'application mobile (un APK se décompile) :
#
#                        supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
#   SUPABASE_SERVICE_ROLE_KEY → contourne toutes les règles de sécurité.
#                        Réservée au serveur.
# ---------------------------------------------------------------------------
