{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },
  "Server": {
    "Urls": "http://127.0.0.1:3001",
    "McpPath": "/mcp",
    "ApiKey": "",
    "PathSecret": ""
  },
  "Robot": {
    "Mode": "Com",
    "ProgId": "Robot.Application",
    "ProcessName": "robot",
    "LaunchIfNotRunning": false,
    "MakeVisibleOnLaunch": true,
    "TypeLibraryPath": "",
    "Apartment": "STA",
    "BusyRetries": 5,
    "BusyRetryDelayMs": 200,
    "ReleaseReleasedValue": "I_BERV_FIXED",
    "ReleaseConnectedValue": "I_BERV_NONE"
  },
  "Safety": {
    "MaxLevel": "Destructive",
    "MassDeletionThreshold": 10,
    "ConfirmationTtlSeconds": 300,
    "CheckpointDirectory": "checkpoints",
    "AutoCheckpoint": true,
    "MaxCheckpoints": 20,
    "AuditLogDirectory": "logs",
    "MaxBatchSize": 5000
  }
}
